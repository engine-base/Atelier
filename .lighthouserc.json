{
  "ci": {
    "collect": {
      "url": [
        "http://127.0.0.1:3000/",
        "http://127.0.0.1:3000/auth/s_a01",
        "http://127.0.0.1:3000/projects/s_b01",
        "http://127.0.0.1:3000/projects/s_b02",
        "http://127.0.0.1:3000/tasks/s_i01"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "_comment": "preset lighthouse:recommended は不採用 — 認証必須アプリに is-crawlable (noindex は意図) を error 要求し、現行 Lighthouse で値を返さない監査 (lcp-lazy-loaded 等) にも minScore を課すため。設計意図 (T-I-09: accessibility のみ error 必達・他は warn) を明示 assertion で表現する",
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.75 }],
        "categories:accessibility": ["error", { "minScore": 0.9 }],
        "categories:best-practices": ["warn", { "minScore": 0.85 }],
        "categories:seo": ["warn", { "minScore": 0.8 }],
        "first-contentful-paint": ["warn", { "maxNumericValue": 2000 }],
        "largest-contentful-paint": ["warn", { "maxNumericValue": 2500 }],
        "cumulative-layout-shift": ["warn", { "maxNumericValue": 0.1 }],
        "total-blocking-time": ["warn", { "maxNumericValue": 200 }]
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
