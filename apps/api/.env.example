# Atelier API — 環境変数テンプレート
#
# このファイル (.env.example) は値を含まない雛形。git に commit する。
# 実値は各自 `cp apps/api/.env.example apps/api/.env` してから埋める。
# .env は .gitignore 済 (絶対に commit しない)。本番値は Fly secrets に投入。
#
# 取得元は SECRETS.md を参照。

# ── DB (Supabase) ─────────────────────────────────────────────
# ローカル: postgresql+asyncpg://atelier_dev:devpass@localhost:5432/atelier_dev
# 本番(Fly): Supabase Session Pooler の asyncpg URL
ATELIER_DB_URL=

# ── 認証 JWT 署名鍵 (HS256) ───────────────────────────────────
# 生成: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
ATELIER_AUTH_JWT_SECRET=

# ── Supabase Auth 連携 (本番のみ。未設定ならローカル DB direct パス) ──
ATELIER_SUPABASE_ADMIN_API_URL=
ATELIER_SUPABASE_ANON_KEY=
ATELIER_SUPABASE_SERVICE_ROLE_KEY=

# ── CORS 追加許可オリジン (カンマ区切り、任意) ────────────────
ATELIER_CORS_EXTRA_ORIGINS=

# ── OAuth サインイン (GAP-020 / S-A01) ────────────────────────
# 未設定のプロバイダは無効 = /auth/oauth/providers に載らず S-A01 にボタンも出ない。
# 取得元:
#   Google: Google Cloud Console → Auth Platform → Clients
#           (ウェブ アプリケーション クライアントを作成)
#   GitHub: GitHub → Settings → Developer settings → OAuth Apps
# 両コンソールに登録する redirect URI (Authorization callback URL) は
#   {ATELIER_API_BASE_URL}/auth/oauth/{provider}/callback
# ローカル開発 (既定) では:
#   http://127.0.0.1:8000/auth/oauth/google/callback
#   http://127.0.0.1:8000/auth/oauth/github/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# API 自身の公開 base URL。OAuth redirect_uri の組み立てに使用。
# 未設定なら http://127.0.0.1:8000 (ローカル開発)。本番は Fly の API URL を設定。
ATELIER_API_BASE_URL=

# web (Next.js) の公開 base URL。OAuth callback 後の着地先
# ({ATELIER_PUBLIC_BASE_URL}/auth/oauth-complete) と magic link / 招待リンクに共通。
# OAuth の文脈では未設定なら http://localhost:3000 (ローカル開発)。
ATELIER_PUBLIC_BASE_URL=

# ── Stripe (GAP-021 決済 / まずテストモード sk_test_) ─────────
# STRIPE_SECRET_KEY: Stripe Dashboard → Developers → API keys → Secret key。
#   テストモードでは sk_test_ で始まる。未設定の環境では課金 API が 503 を返し、
#   S-A03 プランタブは「決済連携が未設定」を表示する (誠実設計 — 偽の課金成功なし)。
STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET: POST /billing/webhook の Stripe-Signature (HMAC v1) 検証鍵。
#   取得方法:
#     - 本番/ステージング: Stripe Dashboard → Developers → Webhooks → Add endpoint で
#       `https://<api-host>/billing/webhook` を登録 (events: checkout.session.completed,
#       customer.subscription.updated, customer.subscription.deleted) →
#       endpoint 詳細の「Signing secret」(whsec_...) をコピーして設定。
#     - ローカル開発: `stripe listen --forward-to localhost:8000/billing/webhook` を実行
#       すると CLI が whsec_... を表示するのでそれを設定。
#   未設定でもローカル開発は可能: 課金反映は GET /billing/checkout/{session_id} の
#   ポーリング照会で完結する (webhook は解約/更新の自動同期用。未設定時は 503)。
# checkout の success/cancel 戻り先は ATELIER_PUBLIC_BASE_URL (上記) を共用する
# ({base}/workspace-settings?session_id=...)。
STRIPE_WEBHOOK_SECRET=

# ── AI 実行経路 (GAP-175: 既定は「利用者本人の Claude サブスク」) ─────
# Atelier の確定アーキテクチャでは、利用者向けの AI 実行はすべて
# **本人の PC の Bridge = 本人の Claude サブスク**で動く。運営は LLM 費用を持たない。
#   ATELIER_LLM_PROVIDER 未設定 = relay (本人の PC で実行) ← 既定・推奨
# Bridge が未接続のときは 503 で正直に断る (黙って運営課金に切り替えない)。
#
# ANTHROPIC_API_KEY は **既定では使われない**。運営の従量課金を使うには
# ATELIER_ALLOW_API_BILLING=1 を明示すること (BYOK / セルフホスト用)。
# 例外: ナレッジ自動キュレーションは運営バッチなので元から運営負担 (この鍵を直接使う)。
ANTHROPIC_API_KEY=
# ATELIER_ALLOW_API_BILLING=1   … 運営の API 課金を許可する (既定は禁止)

# ── RAG の埋め込み (意味検索) ────────────────────────────────
# 既定は **ローカル埋め込み** (fastembed / ONNX)。課金ゼロで、本文が外部に
# 出ない。何も設定しなくてよい。
#
# GAP-180: Voyage は「今は使わない」。ただし将来使う可能性があるので設置は
# できる状態を保つ。**キーを入れただけでは絶対に使われない** —
# ATELIER_ALLOW_VOYAGE=1 を明示したときだけ有効になる (従量課金 = 運営負担、
# ナレッジ本文が Voyage へ送信される)。
VOYAGE_API_KEY=
# ATELIER_ALLOW_VOYAGE=1        … Voyage を実際に使う (既定は使わない)
# ATELIER_LOCAL_EMBEDDING=0     … ローカル埋め込みを止める (意味検索が無効になる)
# ATELIER_LOCAL_EMBEDDING_MODEL … 低スペック機向けの軽量モデルに切替

# ── 議事録の文字起こし (STT) ──────────────────────────────
# GAP-181: 既定は **このサーバー内の faster-whisper** (OSS / MIT)。OpenAI Whisper と
# 同じ重みを使うので精度は同等、費用は 0 円、**顧客の会議音声が外部に出ない**。
# 導入: uv sync --extra localrag (未導入なら文字起こしは「できない」と誠実に出す)
# ATELIER_LOCAL_WHISPER_MODEL=small    … 既定。medium / large-v3 で精度↑速度↓
# ATELIER_LOCAL_WHISPER_DEVICE=cpu     … GPU 環境では cuda
#
# OpenAI Whisper API は削除していないが **キーがあるだけでは使わない**。
# 使うには ATELIER_ALLOW_WHISPER_API=1 を明示すること
# (従量課金 $0.006/分 = 運営負担、音声が OpenAI へ送信される)。
ATELIER_OPENAI_API_KEY=
# ATELIER_ALLOW_WHISPER_API=1   … OpenAI Whisper API を実際に使う (既定は使わない)
# ATELIER_STT_PROVIDER=openai   … 上と併用したときだけ API 経路になる

# ── Claude サブスクリプションモード (GAP-113 / セルフホスト個人専用) ──
# ATELIER_LLM_PROVIDER=agent_sdk にすると chat の LLM 呼出が Anthropic API
# (従量課金) ではなく、実行ホストの Claude Code ログイン (Pro/Max サブスク) を
# 使う Agent SDK 経路になる。API 課金ゼロ。
# 前提: ①実行ホストで `claude` CLI ログイン済 (または CLAUDE_CODE_OAUTH_TOKEN)
#       ② `uv pip install claude-agent-sdk` 済 (optional dep — CI には不要)
# 規約: サブスク認証は「自分のプロンプトのみ処理するパーソナルユース」限定。
#       顧客が使うホスト版では絶対に有効化しない (BYOK / API キーを使う)。
# 制限 (v1): Atelier ツール (save_deliverable 等の agentic 実行) は本モード
#       では未注入。テキスト応答 + RAG/ペルソナ文脈のみ。
# ATELIER_LLM_PROVIDER=agent_sdk
# ATELIER_AGENT_SDK_MODEL=        … 任意。未設定なら CLI 既定モデル

# ── チャットのローカル実行リレー (GAP-114 / ホスト版で各ユーザーのプラン) ──
# ★ GAP-175 以降これが既定。ATELIER_LLM_PROVIDER を未設定にしておけば relay。
# ATELIER_LLM_PROVIDER=relay にすると chat の LLM 実行をサーバーで行わず、
# 各ユーザー PC の Bridge (apps/bridge headless --loop) に中継する。Bridge は
# その PC の Claude ログイン (= 本人の月額プラン) で `claude -p` を実行する。
# Bridge がオフラインの場合チャットは誠実にエラー表示する (黙って課金へ
# 切り替えない)。Bridge 側は ATELIER_BRIDGE_CHAT_RELAY=0 で中継のみ無効化可。
# ATELIER_LLM_PROVIDER=relay
# ATELIER_CHAT_RELAY_TIMEOUT=180  … SSE が応答完了を待つ上限秒 (既定 180)

# ── AI 挙動フラグ (通常は未設定のまま) ────────────────────────
# ATELIER_WEB_SEARCH_DISABLED=1   … chat の web_search tool 注入を無効化 (T-A-51)
# ATELIER_PROMPT_CACHE_DISABLED=1 … system prompt の cache_control 付与を無効化 (T-A-52)
# ATELIER_ALLOW_FAKE_LLM=1        … テスト専用 echo (本番相当検証では絶対に使わない)
